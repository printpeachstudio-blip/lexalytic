ld a financial model, clean a dataset, run a quick calculation, or prototype a process all in the same file without any setup or licensing."}],["$","p",null,{"style":{"fontSize":"17px","color":"var(--ink-2)","lineHeight":"1.85","marginBottom":"24px"},"children":"Excel is the right choice when:"}],["$","div",null,{"style":{"background":"var(--bg-2)","borderRadius":"var(--radius-lg)","padding":"28px","marginBottom":"40px","border":"1px solid var(--border)"},"children":[["$","div","0",{"style":{"display":"flex","gap":"12px","alignItems":"flex-start","marginBottom":"14px"},"children":[["$","span",null,{"style":{"color":"var(--amber)","fontWeight":"600","flexShrink":0},"children":"✓"}],["$","span",null,{"style":{"fontSize":"15px","color":"var(--ink-2)","lineHeight":"1.6"},"children":"You are building financial models that require precise cell referencing and formula logic"}]]}],["$","div","1",{"style":{"display":"flex","gap":"12px","alignItems":"flex-start","marginBottom":"14px"},"children":[["$","span",null,{"style":{"color":"var(--amber)","fontWeight":"600","flexShrink":0},"children":"✓"}],["$","span",null,{"style":{"fontSize":"15px","color":"var(--ink-2)","lineHeight":"1.6"},"children":"Data entry is part of the workflow — Power BI is read-only by design"}]]}],["$","div","2",{"style":{"display":"flex","gap":"12px","alignItems":"flex-start","marginBottom":"14px"},"children":[["$","span",null,{"style":{"color":"var(--amber)","fontWeight":"600","flexShrink":0},"children":"✓"}],["$","span",null,{"style":{"fontSize":"15px","color":"var(--ink-2)","lineHeight":"1.6"},"children":"Your dataset is under 100,000 rows and only one or two people need it"}]]}],["$","div","3",{"style":{"display":"flex","gap":"12px","alignItems":"flex-start","marginBottom":"14px"},"children":[["$","span",null,{"style":{"color":"var(--amber)","fontWeight":"600","flexShrink":0},"children":"✓"}],["$","span",null,{"style":{"fontSize":"15px","color":"var(--ink-2)","lineHeight":"1.6"},"children":"You need 